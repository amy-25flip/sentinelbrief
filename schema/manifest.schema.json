{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelbrief.local/schema/manifest.schema.json",
  "title": "Manifest",
  "description": "Manifest for raw downloaded files",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "filename": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "acquired_at": { "type": "string", "format": "date-time" },
          "etag": { "type": ["string", "null"] },
          "last_modified": { "type": ["string", "null"] },
          "content_type": { "type": "string" },
          "size_bytes": { "type": "integer" },
          "parser_version": { "type": "string" },
          "status": { "type": "string", "enum": ["current", "superseded", "failed"] },
          "acquired_by": { "type": "string" },
          "fetched_by": { "type": "string" },
          "acquisition_note": { "type": "string" },
          "authenticity_exemption": { "type": "string" },
          "reverify_exemption": {
            "type": "string",
            "minLength": 1,
            "description": "Documented reason scripts/reverify_sources.py may skip live re-download for this entry. Only RBI official hosts (CAPTCHA for automated clients) and irdai.gov.in (robots.txt disallows all automated access) may use this."
          }
        },
        "required": ["url", "filename", "sha256", "retrieved_at"]
      }
    }
  }
}
