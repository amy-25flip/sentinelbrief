{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelbrief.local/schema/obligation.schema.json",
  "title": "Obligation",
  "description": "An Obligation is one atomic regulatory requirement",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "instrument_id": {
      "type": "string"
    },
    "paragraph_ref": {
      "type": "string"
    },
    "text_verbatim": {
      "type": "string"
    },
    "normalized": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trigger": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "event",
                "periodic",
                "condition",
                "always"
              ]
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "description"
          ]
        },
        "action": {
          "type": "string"
        },
        "deadline": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "relative",
                "absolute",
                "recurring",
                "retention",
                "immediate",
                "none"
              ]
            },
            "duration_iso8601": {
              "type": [
                "string",
                "null"
              ]
            },
            "alternative_anchors": {
              "type": "array",
              "description": "Other triggers the source text joins with 'or'. The engine starts the clock at the earliest known trigger (conservative reading).",
              "items": {
                "type": "string",
                "enum": [
                  "detection",
                  "noticing",
                  "brought_to_notice",
                  "awareness",
                  "occurrence",
                  "reported"
                ]
              }
            },
            "anchor": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "detection",
                "noticing",
                "brought_to_notice",
                "awareness",
                "occurrence",
                "publication",
                "fixed_date",
                "not_applicable",
                "reported",
                "external_event"
              ]
            },
            "calendar": {
              "type": "string",
              "enum": [
                "continuous",
                "business_days"
              ],
              "default": "continuous"
            },
            "fixed_date": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "fixed_schedule": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
              },
              "description": "Month-day due dates (MM-DD) for a recurring duty tied to the calendar."
            }
          },
          "required": [
            "kind"
          ]
        },
        "recipient": {
          "type": "string"
        },
        "evidence_required": {
          "description": "Evidence the cited text itself requires. Every item must be words quoted from text_verbatim.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggested_evidence": {
          "description": "Operational suggestions written by the dataset authors. Not stated in the source text and not a legal requirement.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "actor",
        "trigger",
        "action",
        "deadline"
      ]
    },
    "applicability": {
      "type": "object",
      "properties": {
        "entity_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "all_of_entity_classes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "excluded_entity_classes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cert_in_annexure_i",
              "personal_data_involved",
              "rbi_cyber_incident",
              "irdai_cyber_incident",
              "sebi_other_cybersecurity_incident",
              "sebi_cybersecurity_incident",
              "sebi_incident_reporting_applies",
              "nciipc_protected_system",
              "sebi_forensic_required"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "validity": {
      "type": "object",
      "properties": {
        "valid_from": {
          "type": "string",
          "format": "date"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "contested_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Before this date it is disputed whether the duty was binding. The duty is still shown, with contested_note as a warning."
        },
        "contested_note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "valid_from",
        "recorded_at"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "in_force",
        "repealed",
        "not_yet_in_force",
        "superseded"
      ]
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "citation.schema.json"
      },
      "minItems": 1
    },
    "extraction": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "manual",
            "rule",
            "llm"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "extractor_version": {
          "type": "string"
        }
      },
      "required": [
        "method",
        "extractor_version"
      ]
    },
    "verification": {
      "type": "string",
      "enum": [
        "unverified",
        "machine_checked",
        "human_verified"
      ]
    },
    "verification_details": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "reviewer": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence_reason": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "instrument_id",
    "text_verbatim",
    "normalized",
    "validity",
    "status",
    "citations",
    "extraction",
    "verification"
  ]
}
