{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelbrief.local/schema/obligation.schema.json",
  "title": "Obligation",
  "description": "An Obligation is one atomic regulatory requirement",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "instrument_id": {
      "type": "string"
    },
    "paragraph_ref": {
      "type": "string"
    },
    "text_verbatim": {
      "type": "string"
    },
    "normalized": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "array",
          "items": { "type": "string" }
        },
        "trigger": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["event", "periodic", "condition", "always"]
            },
            "description": { "type": "string" }
          },
          "required": ["type", "description"]
        },
        "action": {
          "type": "string"
        },
        "deadline": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["relative", "absolute", "recurring", "none"]
            },
            "duration_iso8601": {
              "type": ["string", "null"]
            },
            "anchor": {
              "type": ["string", "null"],
              "enum": ["detection", "noticing", "brought_to_notice", "awareness", "occurrence", "publication", "fixed_date", "not_applicable"]
            },
            "calendar": {
              "type": "string",
              "enum": ["continuous", "business_days"],
              "default": "continuous"
            },
            "fixed_date": {
              "type": ["string", "null"],
              "format": "date"
            }
          },
          "required": ["kind"]
        },
        "recipient": {
          "type": "string"
        },
        "evidence_required": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["actor", "trigger", "action", "deadline"]
    },
    "applicability": {
      "type": "object",
      "properties": {
        "entity_classes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "conditions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "validity": {
      "type": "object",
      "properties": {
        "valid_from": {
          "type": "string",
          "format": "date"
        },
        "valid_to": {
          "type": ["string", "null"],
          "format": "date"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["valid_from", "recorded_at"]
    },
    "status": {
      "type": "string",
      "enum": ["in_force", "repealed", "not_yet_in_force", "superseded"]
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "citation.schema.json"
      },
      "minItems": 1
    },
    "extraction": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": ["manual", "rule", "llm"]
        },
        "model": {
          "type": ["string", "null"]
        },
        "prompt_version": {
          "type": ["string", "null"]
        },
        "extractor_version": {
          "type": "string"
        }
      },
      "required": ["method", "extractor_version"]
    },
    "verification": {
      "type": "string",
      "enum": ["unverified", "machine_checked", "human_verified"]
    },
    "verification_details": {
      "type": ["object", "null"],
      "properties": {
        "reviewer": { "type": "string" },
        "date": { "type": "string", "format": "date" }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence_reason": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "instrument_id",
    "text_verbatim",
    "normalized",
    "validity",
    "status",
    "citations",
    "extraction",
    "verification"
  ]
}
