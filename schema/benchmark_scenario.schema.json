{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelbrief.local/schema/benchmark_scenario.schema.json",
  "title": "Benchmark Scenario",
  "description": "A benchmark scenario for testing the system",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "entity_profile": {
      "type": "object",
      "properties": {
        "entity_class": { "type": "string" },
        "entity_classes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "is_listed": { "type": "boolean" },
        "holds_personal_data": { "type": "boolean" },
        "uses_protected_systems": { "type": ["boolean", "null"] },
        "is_regulated_cloud_vps": { "type": "boolean" },
        "additional_properties": { "type": "object" }
      },
      "required": ["is_listed", "holds_personal_data", "is_regulated_cloud_vps"],
      "oneOf": [
        { "required": ["entity_class"], "not": { "required": ["entity_classes"] } },
        { "required": ["entity_classes"], "not": { "required": ["entity_class"] } }
      ]
    },
    "incident_facts": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "incident_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "when_detected": { "type": ["string", "null"], "format": "date-time" },
        "when_noticed": { "type": ["string", "null"], "format": "date-time" },
        "when_occurred": { "type": ["string", "null"], "format": "date-time" },
        "when_brought_to_notice": { "type": ["string", "null"], "format": "date-time" },
        "when_reported_to_sebi": { "type": ["string", "null"], "format": "date-time" },
        "external_events": { "type": "object", "additionalProperties": { "type": "string", "format": "date-time" } },
        "is_annexure_i_type": { "type": ["boolean", "null"], "description": "Explicit user attestation; only false can exclude Annexure I" },
        "sebi_severity": { "type": ["string", "null"], "enum": ["low", "medium", "high", "critical", null] },
        "is_cyber_incident": { "type": ["boolean", "null"], "description": "Explicit user attestation against the RBI paragraph 4(7) definition" },
        "annexure_i_items": { "type": "array", "items": { "type": "string" } },
        "personal_data_involved": { "type": ["boolean", "null"] },
        "systems_affected": {
          "type": "array",
          "items": { "type": "string" }
        },
        "additional_facts": { "type": "object" }
      },
      "required": ["description", "incident_types", "systems_affected"]
    },
    "law_snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "expected": {
      "type": "object",
      "properties": {
        "law_as_of": {
          "type": "string",
          "format": "date",
          "description": "The date whose law should apply: the IST date of the earliest known incident time (or the evaluation date if none is known)"
        },
        "regulators": {
          "type": "array",
          "items": { "type": "string" }
        },
        "deadlines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "regulator": { "type": "string" },
              "obligation_id": { "type": "string" },
              "anchor": { "type": "string" },
              "deadline_iso8601": { "type": "string" },
              "deadline_timestamp": { "type": "string", "format": "date-time" }
            },
            "required": ["regulator", "obligation_id", "anchor", "deadline_iso8601", "deadline_timestamp"]
          }
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "obligation_id": { "type": "string" },
              "instrument_id": { "type": "string" },
              "paragraph_ref": { "type": "string" }
            },
            "required": ["obligation_id", "instrument_id", "paragraph_ref"]
          }
        },
        "required_evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "not_applicable": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "regulator": { "type": "string" },
              "obligation_id": { "type": "string" },
              "reason": { "type": "string" }
            },
            "required": ["regulator", "obligation_id", "reason"]
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": { "type": "string", "description": "Case-insensitive substring that must appear in the question the engine asks" },
              "affects": { "type": "string", "description": "Obligation id the question blocks" }
            },
            "required": ["question", "affects"]
          }
        },
        "time_critical": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "caveats_contain": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "required": ["regulators", "deadlines", "citations", "required_evidence", "not_applicable", "unknowns"]
    },
    "adversarial_flags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "split": {
      "type": "string",
      "enum": ["dev", "hidden"]
    },
    "labels_source": {
      "type": "string"
    },
    "source_quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document": { "type": "string" },
          "page": { "type": "integer", "minimum": 1 },
          "quote": { "type": "string", "minLength": 1 }
        },
        "required": ["document", "page", "quote"]
      }
    }
  },
  "required": ["id", "description", "entity_profile", "incident_facts", "law_snapshot_date", "expected", "split"]
}
