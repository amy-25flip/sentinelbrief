{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelbrief.local/schema/citation.schema.json",
  "title": "Citation",
  "description": "A Citation links a claim to a verbatim span of source text",
  "type": "object",
  "properties": {
    "instrument_id": {
      "type": "string"
    },
    "paragraph_ref": {
      "type": "string"
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "char_start": {
      "type": "integer",
      "minimum": 0
    },
    "char_end": {
      "type": "integer",
      "minimum": 0
    },
    "bbox": {
      "type": ["object", "null"],
      "properties": {
        "x0": { "type": "number" },
        "y0": { "type": "number" },
        "x1": { "type": "number" },
        "y1": { "type": "number" }
      },
      "required": ["x0", "y0", "x1", "y1"]
    },
    "excerpt_verbatim": {
      "type": "string",
      "minLength": 10
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": ["instrument_id", "excerpt_verbatim", "source_sha256"]
}
