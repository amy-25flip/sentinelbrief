{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelbrief.local/schema/entity_class.schema.json",
  "title": "Entity Class",
  "description": "Taxonomy for regulatory applicability",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "regulator": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "parent": {
      "type": ["string", "null"]
    },
    "description": {
      "type": "string"
    },
    "needs_refinement": {
      "type": "boolean",
      "default": false
    },
    "refinement_question": {
      "description": "Asked when a profile holds only this needs_refinement class.",
      "type": "string"
    },
    "refinement_note": {
      "description": "Added to the impact text of the refinement question, for example to state what the dataset does not cover.",
      "type": "string"
    },
    "is_role": {
      "type": "boolean",
      "default": false
    },
    "version": {
      "type": "string"
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_to": {
      "type": ["string", "null"],
      "format": "date"
    }
  },
  "required": ["id", "regulator", "label", "version"]
}
